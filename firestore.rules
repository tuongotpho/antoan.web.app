rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {
    // === HÀM HỖ TRỢ ===
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isAuthenticated() {
      return request.auth != null;
    }

    // Đối tác ĐÃ ĐƯỢC DUYỆT. Dùng thay cho isAuthenticated() ở những chỗ chứa
    // dữ liệu kinh doanh: tạo tài khoản Google chỉ mất 10 giây, nên
    // "đã đăng nhập" gần như tương đương "bất kỳ ai trên Internet".
    function isApprovedPartner() {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/partners/$(request.auth.uid))
             && get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status == 'approved';
    }

    // === YÊU CẦU HUẤN LUYỆN ===

    match /trainingRequests/{requestId} {
      allow create: if true;  // Ai cũng tạo được (public form)

      // Danh sách yêu cầu là tài sản kinh doanh: chứa tên công ty, người liên
      // hệ, SĐT, email, số học viên. Trước đây mở cho MỌI tài khoản đã đăng
      // nhập — đối thủ chỉ cần đăng ký một tài khoản là hút sạch lead.
      allow read: if isAdmin() || isApprovedPartner();

      // Đối tác đã duyệt chỉ được đánh dấu đã xem
      allow update: if isApprovedPartner() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
      ) || isAdmin();  // Admin update tất cả

      allow delete: if isAdmin();  // Chỉ admin xóa được
    }

    // === HỒ SƠ ĐỐI TÁC ===

    match /partners/{partnerId} {
      // Đối tác tự đăng ký hồ sơ của chính mình, HOẶC admin tự tạo hồ sơ hộ.
      //
      // Vế isAdmin() là mới: trước đây chỉ cho tạo hồ sơ trùng uid người gọi,
      // nên admin không thể tự nhập danh sách đối tác đã có sẵn ngoài đời —
      // phải chờ từng đơn vị vào đăng ký rồi mới duyệt được.
      allow create: if (isAuthenticated() && request.auth.uid == partnerId) || isAdmin();

      // Hồ sơ ĐÃ DUYỆT đọc được công khai; hồ sơ chờ duyệt hoặc bị từ chối thì
      // phải đăng nhập.
      //
      // Mở phần này là điều kiện bắt buộc để trang chủ giới thiệu được đối tác
      // với khách vãng lai — trước đây khách chưa đăng nhập luôn thấy dòng
      // "Đang cập nhật đối tác" dù danh sách có người.
      //
      // ĐÁNH ĐỔI đã cân nhắc: email và số điện thoại của đối tác đã duyệt trở
      // thành công khai. Chấp nhận được vì đơn vị đào tạo lên đây chính là để
      // khách tìm thấy và liên hệ — khác hẳn thông tin khách hàng, thứ vẫn
      // khoá kín trong trainingRequests.
      //
      // Lưu ý kỹ thuật: truy vấn danh sách phải kèm where('status','==','approved')
      // thì mới qua được rules, vì Firestore đòi mọi bản ghi trả về đều thoả.
      allow read: if resource.data.status == 'approved' || isAuthenticated();

      allow update: if isAuthenticated() && (request.auth.uid == partnerId || isAdmin());
      allow delete: if isAdmin();
    }

    // === BÁO GIÁ ===
    match /quotes/{quoteId} {

// Partner tạo báo giá
      allow create: if isAuthenticated()
                    && request.resource.data.partnerId == request.auth.uid;

      // Partner xem và update báo giá của mình
      allow read, update: if isAuthenticated()
                          && resource.data.partnerId == request.auth.uid;

      // Admin xem tất cả báo giá
      allow read: if isAdmin();

      // Partner xóa báo giá của mình
      allow delete: if isAuthenticated()
                    && resource.data.partnerId == request.auth.uid;
    }

    // === TÀI LIỆU ===
    match /documents/{docId} {
      allow read: if true;  // Ai cũng đọc được
      allow create, update, delete: if isAdmin();  // Chỉ admin quản lý
    }

    // === ADMIN COLLECTION ===
    match /admins/{adminId} {

      // Cho phép user kiểm tra xem mình có phải admin không
      allow get: if isAuthenticated() && request.auth.uid == adminId;

      // Không cho list, create, update, delete từ client
      allow list, write: if false;
    }

    // === EMAIL COLLECTION (cho Firebase Extension) ===
    //
    // TRƯỚC ĐÂY: `allow create: if true` — client tự đặt to/subject/html rồi
    // extension gửi đi. Tức bất kỳ ai trên Internet cũng gửi được email tuỳ ý
    // mang tên miền này: lừa đảo, spam, và tên miền bị đưa vào danh sách đen.
    //
    // NAY: client không ghi thẳng nữa. Mọi email đi qua Cloud Function
    // (Admin SDK bỏ qua rules), nên khoá hoàn toàn phía client.
    match /mail/{mailId} {
      allow create, read, update, delete: if false;
    }

    // === USERS COLLECTION (optional) ===
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

 // === CHAT ROOMS ===
    match /chatRooms/{roomId} {
      // Users can read rooms they are part of (client or partner)
      allow read: if isAuthenticated() &&
                  (resource.data.clientId == request.auth.uid ||
                   resource.data.partnerId == request.auth.uid ||
                   isAdmin());

      // Only authenticated users can create rooms
      allow create: if isAuthenticated();

      // Only participants can update room (last message, unread count)
      allow update: if isAuthenticated() &&
                    (resource.data.clientId == request.auth.uid ||
                     resource.data.partnerId == request.auth.uid ||
                     isAdmin());

      // Only admin can delete rooms
      allow delete: if isAdmin();
    }

    // === CHAT MESSAGES ===
    match /chatMessages/{messageId} {
      // Users can ONLY read messages from rooms they are participants of
      allow read: if isAuthenticated() && (
        // Check if message belongs to a room where user is client or partner
        exists(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)) &&
        (get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data.clientId == request.auth.uid ||
         get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data.partnerId == request.auth.uid ||
         isAdmin())
      );

      // Authenticated users can create messages only in rooms they participate
      allow create: if isAuthenticated() &&
                    request.resource.data.senderId == request.auth.uid &&
                    (get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.clientId == request.auth.uid ||
                     get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.partnerId == request.auth.uid);

      // Người gửi và admin sửa được tin nhắn của mình.
      //
      // NGOÀI RA người NHẬN phải đánh dấu được "đã đọc" — trước đây điều kiện
      // chỉ có senderId nên chính người nhận lại không có quyền đặt read = true.
      // Kết quả: ChatWindow gọi updateDoc mỗi lần mở phòng chat và luôn bị từ
      // chối, tính năng "đã đọc" cùng bộ đếm tin chưa đọc hỏng âm thầm.
      //
      // Nhánh thêm vào bị khoá chặt: chỉ được đổi đúng một trường `read`, và
      // chỉ dành cho người thuộc phòng chat đó.
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid
        || isAdmin()
        || (
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
             && exists(/databases/$(database)/documents/chatRooms/$(resource.data.roomId))
             && (
                  get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data.clientId == request.auth.uid
                  || get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data.partnerId == request.auth.uid
                )
           )
      );

      // Only admin can delete messages
      allow delete: if isAdmin();
    }

    // === BLOG POSTS ===
    match /blogPosts/{postId} {
      // Anyone can read published posts
      allow read: if resource.data.published == true || (request.auth != null && isAdmin());

      // Anyone can update viewCount, only admins can update other fields
      allow update: if isAdmin() ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));

      // Only admins can create and delete posts
      allow create, delete: if isAdmin();
    }

    // === BLOG COMMENTS ===
    match /blogComments/{commentId} {
      // Anyone can read comments for published blog posts
      allow read: if true;

      // Authenticated users can create comments
      allow create: if isAuthenticated() &&
                    request.resource.data.authorId == request.auth.uid;

      // Only comment author or admin can update their own comments
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );

      // Only comment author or admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // === DEFAULT DENY ===

    match /{document=**} {

      allow read, write: if false;

    }

  }

}