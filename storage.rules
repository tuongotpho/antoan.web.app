rules_version = '2';

service firebase.storage {
match /b/{bucket}/o {

    // === HÀM HỖ TRỢ ===
    function isAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Validate file size and type
    function validFileSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    function validFileType(allowedTypes) {
      return request.resource.contentType.matches(allowedTypes);
    }

    // === BLOG COVER IMAGES ===
    match /blog-covers/{imageId} {

      // Anyone can read blog cover images (public)
      allow read: if true;

      // Only admins can upload/update/delete blog covers
      allow create, update, delete: if isAdmin();
    }

    // === BLOG COMMENT IMAGES ===
    match /blog-comments/{postId}/{imageId} {

      // Anyone can read comment images (public)
      allow read: if true;

      // Authenticated users can upload images for comments
      // Validate image type and size (max 5MB per image)
      allow create: if isAuthenticated() &&
                      validFileSize(5) &&
                      validFileType('image/.*');

      // Chỉ admin xoá — trước đây `isAuthenticated() || isAdmin()` nghĩa là
      // bất kỳ ai đăng nhập cũng xoá được ảnh bình luận của người khác.
      allow delete: if isAdmin();
    }

    // === DOCUMENT UPLOADS ===
    match /documents/{documentId} {
      // Anyone can read/download documents
      allow read: if true;

      // Only admins can upload/update/delete documents
      // Validate file type and size for security
      allow create, update: if isAdmin() &&
                              validFileSize(10) &&
                              validFileType('(image/.*|application/pdf|application/msword|application/vnd\\..*|text/.*)');
      allow delete: if isAdmin();
    }

    // === QUOTE ATTACHMENTS ===
    // File báo giá chứa giá và năng lực của từng đối tác. Trước đây mọi tài
    // khoản đã đăng nhập đều đọc/sửa/XOÁ được file của người khác — vừa lộ giá
    // cho đối thủ, vừa cho phép phá hoại. Nay đặt file trong thư mục theo uid
    // để chỉ chủ file và admin thao tác được.
    match /quote-attachments/{userId}/{attachmentId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       validFileSize(10);
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // === CHAT ATTACHMENTS ===
    // Comment cũ ghi "chỉ xoá file của mình" nhưng điều kiện thực tế là
    // `request.auth.uid != null` — tức chỉ cần đăng nhập là xoá được file của
    // bất kỳ ai. Nay uid nằm trong đường dẫn nên ràng buộc được thật.
    match /chat-attachments/{userId}/{fileName} {
      // Người trong cuộc trò chuyện cần đọc được file đối phương gửi,
      // nên vẫn cho mọi tài khoản đã đăng nhập đọc.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       validFileSize(10);
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // === DEFAULT DENY ===
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }

}