# Cấu hình Firebase phía client.
# Các khoá này công khai theo thiết kế — việc chặn truy cập do firestore.rules
# và storage.rules đảm nhiệm, không phải do giấu khoá.
# Bỏ trống thì app dùng giá trị dự phòng trong services/firebaseConfig.ts
# (đang trỏ project atld-connect).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# KHÔNG đặt khoá Gemini ở đây.
#
# Mọi biến bắt đầu bằng VITE_ đều được đóng gói thẳng vào phần chạy trên trình
# duyệt — ai xem mã trang cũng đọc được, và hoá đơn AI thì chủ trang chịu.
# Trước đây file này có dòng VITE_GEMINI_API_KEY= mời điền, dù không một dòng mã
# nào đọc tới nó: một cái bẫy chờ người dùng sập.
#
# Khoá Gemini nằm ở phía máy chủ, đặt bằng:
#   firebase functions:secrets:set GEMINI_API_KEY
# Cloud Function generateBlogPost / improveBlogContent sẽ đọc từ đó.
